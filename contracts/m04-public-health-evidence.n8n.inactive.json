    { "id": "bounded-public-get", "kind": "GET_ONLY_NO_COOKIES", "enabled": false },
    { "id": "sanitize", "kind": "ALLOWLIST_BITMAP", "enabled": false },
    { "id": "store-control-plane-evidence", "kind": "NEON_OPAQUE_METADATA_ONLY", "enabled": false }
  ]
