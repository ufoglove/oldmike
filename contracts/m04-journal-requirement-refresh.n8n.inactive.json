  "nodes": [
    { "id": "schedule", "kind": "DISABLED_SCHEDULE", "enabled": false },
    { "id": "source-policy", "kind": "OFFICIAL_SOURCE_ALLOWLIST", "enabled": false },
    { "id": "bounded-get", "kind": "PUBLIC_HTTPS_GET", "enabled": false },
    { "id": "store-sanitized-observation", "kind": "OPAQUE_STATUS_HASH_ONLY", "enabled": false }
  ]
}
