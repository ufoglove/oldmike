{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://old-mike.invalid/contracts/review-automation-job.schema.json",
  "title": "老麥審稿自動化不透明工作契約",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "jobId", "operation", "idempotencyKey", "requestedAt", "status", "sourceHash", "resultHash"],
  "properties": {
    "contractVersion": { "const": "review-automation/1.0.0" },
    "jobId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
    "operation": { "enum": ["REVIEW", "RE_REVIEW", "DOCUMENT_RELEASE"] },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["QUEUED", "RUNNING", "WAITING_HUMAN", "COMPLETED", "FAILED", "CANCELED"] },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resultHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
