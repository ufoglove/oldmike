{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://old-mike.invalid/contracts/review-studio.schema.json",
  "title": "老麥審稿工作室固定結果",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "status", "cycle", "qualityDelta", "lenses", "findings", "uncertainties"],
  "properties": {
    "contractVersion": { "const": "review-studio/1.0.0" },
    "status": { "const": "SUCCESS" },
    "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "qualityDelta": { "type": "integer", "minimum": 0, "maximum": 100 },
    "lenses": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "enum": ["ARGUMENT_STRUCTURE", "METHOD", "EVIDENCE_CLAIM_SUPPORT", "CLARITY", "TERMINOLOGY", "JOURNAL_FIT", "ETHICS_REPRODUCIBILITY"] } },
    "findings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/finding" } },
    "uncertainties": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 800 } }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "lens", "severity", "paragraphId", "startOffset", "endOffset", "sourceSpanHash", "suggestedRevision", "rationale", "risk", "uncertainty", "action"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
        "lens": { "enum": ["ARGUMENT_STRUCTURE", "METHOD", "EVIDENCE_CLAIM_SUPPORT", "CLARITY", "TERMINOLOGY", "JOURNAL_FIT", "ETHICS_REPRODUCIBILITY"] },
        "severity": { "enum": ["P0", "P1", "P2"] },
        "paragraphId": { "type": "string", "pattern": "^p-[0-9]{3}$" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 },
        "sourceSpanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "suggestedRevision": { "type": "string", "maxLength": 6000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "risk": { "type": "string", "minLength": 1, "maxLength": 800 },
        "uncertainty": { "type": "string", "minLength": 1, "maxLength": 800 },
        "action": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    }
  }
}
