# v1.5.16 server-only authentication and administrator provisioning policy.
# Integration-only fixture flags; keep disabled and do not configure them in deployments.
INTEGRATION_TEST_MODE=0
TEST_FIXTURE=0
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://oldmike-research.zeabur.app
REGISTRATION_MODE=closed
ACCOUNT_PROVISIONING_MODE=admin_only
LEGACY_AUTH_ENABLED=false

# Existing M01-M04 helpers and Project Chat remain server-only, use the same
# existing private network configuration, and append exactly
# /v1/chat/completions. The fixed logical default-agent alias defers backend
# model selection to the upstream owner configuration. No separate Project Chat
# provider/model/endpoint configuration is accepted.
OPENCLAW_BASE_URL=
OPENCLAW_GATEWAY_TOKEN=

# v1.5.19 server-side public-web reader. Keep disabled until the exact
# deployment, runtime and public smoke gates have passed. This does not grant
# private-network, authenticated-browser, filesystem or external-write access.
OLD_MIKE_WEB_RESEARCH_MODE=disabled
